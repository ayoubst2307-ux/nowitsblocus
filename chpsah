-- ============================================================
--  ESP
-- ============================================================
local esp_cache: { [Player]: { box:any, name:any, hp:any, dist:any } } = {}
local Camera = workspace.CurrentCamera

local function esp_add(p: Player)
    if esp_cache[p] then return end
    local function sq(f, c) local d=Drawing.new("Square"); d.Thickness=1.5; d.Filled=f; d.Color=c; d.Visible=false; return d end
    local function tx(s, c) local d=Drawing.new("Text"); d.Size=s; d.Center=true; d.Outline=true; d.Color=c; d.Visible=false; return d end
    esp_cache[p] = {
        box  = sq(false, Color3.fromRGB(255,60,60)),
        name = tx(12,    Color3.fromRGB(255,255,255)),
        hp   = sq(true,  Color3.fromRGB(60,255,60)),
        dist = tx(10,    Color3.fromRGB(255,200,50)),
    }
end

local function esp_hide(p: Player)
    if not esp_cache[p] then return end
    for _,d in pairs(esp_cache[p]) do d.Visible = false end
end

local function esp_remove(p: Player)
    if not esp_cache[p] then return end
    for _,d in pairs(esp_cache[p]) do d:Remove() end
    esp_cache[p] = nil
end

Players.PlayerRemoving:Connect(esp_remove)

RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then esp_hide(p); continue end
        local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then esp_hide(p); continue end
        if not esp_on() then esp_hide(p); continue end

        esp_add(p)
        local ds = esp_cache[p]
        local sp, vis = Camera:WorldToViewportPoint(root.Position)
        if not vis then esp_hide(p); continue end

        local dist  = (root.Position - Camera.CFrame.Position).Magnitude
        local scale = 1600 / dist
        local bw, bh = scale * 1.0, scale * 1.8

        ds.box.Size     = Vector2.new(bw, bh)
        ds.box.Position = Vector2.new(sp.X - bw/2, sp.Y - bh/2)
        ds.box.Visible  = true

        ds.name.Text     = p.DisplayName
        ds.name.Position = Vector2.new(sp.X, sp.Y - bh/2 - 14)
        ds.name.Visible  = true

        ds.dist.Text     = math.floor(dist) .. "m"
        ds.dist.Position = Vector2.new(sp.X, sp.Y + bh/2 + 2)
        ds.dist.Visible  = true

        local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth,1), 0, 1)
        ds.hp.Color    = Color3.fromRGB(math.floor((1-ratio)*255), math.floor(ratio*220), 50)
        ds.hp.Size     = Vector2.new(3, bh * ratio)
        ds.hp.Position = Vector2.new(sp.X - bw/2 - 7, sp.Y - bh/2 + bh*(1-ratio))
        ds.hp.Visible  = true
    end
end)

-- ============================================================
--  SILENT AIMBOT — téléporte la caméra sur la tête du plus proche
-- ============================================================
local function get_closest(): (BasePart?, number)
    local closest_part: BasePart? = nil
    local closest_dist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then continue end
        local head = char:FindFirstChild("Head") :: BasePart?
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then continue end
        local dist = (head.Position - Camera.CFrame.Position).Magnitude
        if dist < closest_dist then
            closest_dist = dist
            closest_part = head
        end
    end
    return closest_part, closest_dist
end

RunService.RenderStepped:Connect(function()
    if not aimbot_on() then return end
    local head, _ = get_closest()
    if not head then return end
    -- silent : on oriente juste la caméra vers la cible sans bouger le perso
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return end
    -- lock le regard vers la tête
    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, head.Position)
end)

