-- ============================================================
--  SPIN TROLL — fait tourner le perso sur lui-même
-- ============================================================
local spin_angle = 0
RunService.Heartbeat:Connect(function(dt)
    if not spin_on() then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return end
    spin_angle = (spin_angle + dt * 720) % 360
    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(spin_angle), 0)
end)

-- ============================================================
--  FLOAT TROLL — lévite doucement
-- ============================================================
RunService.Heartbeat:Connect(function()
    if not float_on() then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum:ChangeState(Enum.HumanoidStateType.Physics) end
    root.AssemblyLinearVelocity = Vector3.new(
        root.AssemblyLinearVelocity.X,
        2,
        root.AssemblyLinearVelocity.Z
    )
end)

-- ============================================================
--  FREEZE JOUEURS TROLL — téléporte tous les joueurs sur place
--  (client-sided : les freezes sont visibles que pour toi)
-- ============================================================
RunService.Heartbeat:Connect(function()
    if not freeze_on() then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
end)

